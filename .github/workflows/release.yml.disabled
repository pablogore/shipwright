name: Release Pipeline

# GitHub Actions workflow for automated releases
on:
  push:
    branches: [ main ]
    tags: [ 'v*' ]
  workflow_dispatch:
    inputs:
      version:
        description: 'Version to release (e.g., v1.0.0)'
        required: false
        default: ''
      version_type:
        description: 'Version bump type'
        required: false
        default: 'auto'
        type: choice
        options:
        - auto
        - major
        - minor
        - patch

env:
  GO_VERSION: '1.25.1'
  RELEASE_DIR: 'release'
  CACHE_VERSION: v1

jobs:
  # Stage 1: Determine version and generate changelog
  determine-version:
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.version.outputs.version }}
      tag: ${{ steps.version.outputs.tag }}
      changelog: ${{ steps.changelog.outputs.changelog }}
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
      with:
        fetch-depth: 0  # Fetch full history for version determination
        
    - name: Configure Git
      run: |
        git config --global user.name "GitHub Actions"
        git config --global user.email "actions@github.com"
        
    - name: Determine version
      id: version
      run: |
        echo "🏷️ Determining version..."
        
        # Check if version is provided via workflow_dispatch
        if [[ "${{ github.event_name }}" == "workflow_dispatch" && -n "${{ github.event.inputs.version }}" ]]; then
          VERSION="${{ github.event.inputs.version}}"
          echo "Using provided version: $VERSION"
        else
          # Get latest tag
          LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
          echo "Latest tag: $LATEST_TAG"
          
          if [[ -n "$LATEST_TAG" ]]; then
            # Extract version number
            VERSION_NUMBER=$(echo $LATEST_TAG | sed 's/v//')
            echo "Version number: $VERSION_NUMBER"
            
            # Determine version bump based on commit messages
            COMMITS=$(git log --oneline $LATEST_TAG..HEAD)
            echo "Commits since $LATEST_TAG:"
            echo "$COMMITS"
          else
            # No tags exist, start from v0.0.0
            VERSION_NUMBER="0.0.0"
            echo "No tags found, starting from v0.0.0"
            
            # Get all commits
            COMMITS=$(git log --oneline --max-count=10)
            echo "Recent commits:"
            echo "$COMMITS"
          fi
          
          # Check for conventional commits
          if echo "$COMMITS" | grep -q "feat!:\|BREAKING CHANGE"; then
            BUMP_TYPE="major"
            echo "🚨 Major version bump detected (breaking change)"
          elif echo "$COMMITS" | grep -q "fix!:"; then
            BUMP_TYPE="major"
            echo "🚨 Major version bump detected (breaking fix)"
          elif echo "$COMMITS" | grep -q "^feat:"; then
            BUMP_TYPE="minor"
            echo "✨ Minor version bump detected (new feature)"
          elif echo "$COMMITS" | grep -q "^fix:"; then
            BUMP_TYPE="patch"
            echo "🐛 Patch version bump detected (bug fix)"
          else
            BUMP_TYPE="patch"
            echo "📝 Patch version bump (default for other changes)"
          fi
          
          # Bump version
          IFS='.' read -r MAJOR MINOR PATCH <<< "$VERSION_NUMBER"
          
          case $BUMP_TYPE in
            major)
              MAJOR=$((MAJOR + 1))
              MINOR=0
              PATCH=0
              ;;
            minor)
              MINOR=$((MINOR + 1))
              PATCH=0
              ;;
            patch)
              PATCH=$((PATCH + 1))
              ;;
          esac
          
          VERSION_NUMBER="$MAJOR.$MINOR.$PATCH"
          VERSION="v$VERSION_NUMBER"
        fi
        
        # Create tag name
        TAG="$VERSION"
        
        echo "version=$VERSION" >> $GITHUB_OUTPUT
        echo "tag=$TAG" >> $GITHUB_OUTPUT
        echo "✅ Version determined: $VERSION"
        
    - name: Generate changelog
      id: changelog
      run: |
        echo "📝 Generating changelog..."
        
        # Get latest tag
        LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
        
        if [[ -n "$LATEST_TAG" ]]; then
          CHANGELOG=$(git log --pretty=format:"- %s (%h)" $LATEST_TAG..HEAD)
        else
          CHANGELOG=$(git log --pretty=format:"- %s (%h)" --max-count=10)
        fi
        
        echo "$CHANGELOG" > CHANGELOG.md
        echo "changelog<<EOF" >> $GITHUB_OUTPUT
        echo "$CHANGELOG" >> $GITHUB_OUTPUT
        echo "EOF" >> $GITHUB_OUTPUT
        echo "✅ Changelog generated"

  # Stage 2: Build and test
  build-and-test:
    runs-on: ubuntu-latest
    needs: determine-version
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
      
    - name: Set up Go
      uses: actions/setup-go@v6
      with:
        go-version: ${{ env.GO_VERSION }}
        cache: false
        
    - name: Cache Go modules
      uses: actions/cache@v4
      with:
        path: |
          ~/.cache/go-build
          ~/go/pkg/mod
        key: ${{ runner.os }}-go-${{ hashFiles('**/go.sum') }}-${{ env.CACHE_VERSION }}
        restore-keys: |
          ${{ runner.os }}-go-${{ hashFiles('**/go.sum') }}-
          ${{ runner.os }}-go-
          
    - name: Download dependencies
      run: go mod download
      
    - name: Verify dependencies
      run: go mod verify
      
    - name: Run tests
      run: go test -v ./...
      
    - name: Run security scan
      run: |
        echo "🔒 Running security scan..."
        go vet ./...
        go list -json -deps ./... | grep -i "crypto\|hash\|rand" || true
        echo "✅ Security scan completed"

  # Stage 3: Build binaries
  build-binaries:
    runs-on: ubuntu-latest
    needs: [determine-version, build-and-test]
    strategy:
      matrix:
        include:
        - os: linux
          arch: amd64
          ext: ''
        - os: linux
          arch: arm64
          ext: ''
        - os: darwin
          arch: amd64
          ext: ''
        - os: darwin
          arch: arm64
          ext: ''
        - os: windows
          arch: amd64
          ext: '.exe'
        - os: windows
          arch: arm64
          ext: '.exe'
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
      
    - name: Set up Go
      uses: actions/setup-go@v6
      with:
        go-version: ${{ env.GO_VERSION }}
        
    - name: Build binary
      run: |
        echo "🔨 Building binary for ${{ matrix.os }}/${{ matrix.arch }}..."
        GOOS=${{ matrix.os }} GOARCH=${{ matrix.arch }} go build -ldflags="-s -w" -o syntegrity-dagger-${{ matrix.os }}-${{ matrix.arch }}${{ matrix.ext }} .
        echo "✅ Binary built successfully"
        
    - name: Upload binary
      uses: actions/upload-artifact@v4
      with:
        name: syntegrity-dagger-${{ matrix.os }}-${{ matrix.arch }}
        path: syntegrity-dagger-${{ matrix.os }}-${{ matrix.arch }}${{ matrix.ext }}

  # Stage 4: Create release
  create-release:
    runs-on: ubuntu-latest
    needs: [determine-version, build-and-test, build-binaries]
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
      
    - name: Download all binaries
      uses: actions/download-artifact@v4
      with:
        path: ./binaries
        
    - name: Create release directory and organize binaries
      run: |
        echo "📁 Creating release directory..."
        mkdir -p ${{ env.RELEASE_DIR }}
        
        echo "📦 Organizing binaries..."
        find ./binaries -name "syntegrity-dagger-*" -type f -exec cp {} ${{ env.RELEASE_DIR }}/ \;
        
        echo "📋 Release contents:"
        ls -la ${{ env.RELEASE_DIR }}/
        
    - name: Create Release
      uses: softprops/action-gh-release@v2
      with:
        tag_name: ${{ needs.determine-version.outputs.tag }}
        name: Release ${{ needs.determine-version.outputs.version }}
        body: |
          ## Changes in this release
          
          ${{ needs.determine-version.outputs.changelog }}
          
          ## Downloads
          
          Download the appropriate binary for your platform:
          
          - **Linux AMD64**: `syntegrity-dagger-linux-amd64`
          - **Linux ARM64**: `syntegrity-dagger-linux-arm64`
          - **macOS AMD64**: `syntegrity-dagger-darwin-amd64`
          - **macOS ARM64**: `syntegrity-dagger-darwin-arm64`
          - **Windows AMD64**: `syntegrity-dagger-windows-amd64.exe`
          - **Windows ARM64**: `syntegrity-dagger-windows-arm64.exe`
        files: ${{ env.RELEASE_DIR }}/*
        draft: false
        prerelease: false
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}